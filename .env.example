# ==============================================================================
# Variáveis de Ambiente - Sistema de Tutoria Assíncrono com IA
# Copie este arquivo para ".env" na raiz do projeto e preencha sua GEMINI_API_KEY
# ==============================================================================

# Chave gratuita da API do Groq (crie em https://console.groq.com/keys)
# Modelos gratuitos sugeridos no Groq:
# - openai/gpt-oss-20b (ultra rapido ~1000 tok/s, 1.000 req/dia)
# - openai/gpt-oss-120b (mais capaz, 1.000 req/dia)
# - llama-3.1-8b-instant (alta cota diaria)
GROQ_API_KEY=coloque_sua_chave_groq_aqui
GROQ_MODEL=openai/gpt-oss-20b

# RabbitMQ (Docker Compose)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=tutoria
RABBITMQ_PASS=tutoria123

# Gateway (JWT - mínimo de 32 caracteres para HS256)
JWT_SECRET=chave-secreta-super-segura-para-o-trabalho-de-tutoria-com-ia-2026
JWT_EXPIRATION_MS=86400000

# Front-end
VITE_API_URL=http://localhost:8080
